# --- Clerk (auth) ---
# https://dashboard.clerk.com -> Create app -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Supabase (database, vector store, file storage) ---
# https://supabase.com/dashboard -> Project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Claude, chat generation) ---
# https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=

# --- Voyage AI (embeddings) ---
# https://dashboard.voyageai.com -> API Keys
VOYAGE_API_KEY=

# --- Stripe (billing) ---
# https://dashboard.stripe.com -> Developers -> API Keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
